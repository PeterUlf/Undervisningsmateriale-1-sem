---
import { getCollection, type CollectionEntry } from 'astro:content';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';

interface TemaLink {
  title: string;
  description: string;
  href: string;
}

interface TemaSection {
  name: string;
  number: string;
  items: TemaLink[];
}

const extractTemaNumber = (value: string) => value.match(/\d+/)?.[0] || value;
const getTemaOrder = (value: string) => Number.parseInt(extractTemaNumber(value), 10) || 0;

const createTemaLink = (doc: CollectionEntry<'docs'>): TemaLink => {
  const slug = doc.id.replace(/\.mdx?$/, '');

  return {
    title: doc.data.title,
    description: doc.data.description || '',
    href: `/${slug}`,
  };
};

let temaSections: TemaSection[] = [];
let loadError = '';

try {
  const docs = await getCollection('docs');
  const temaMap = new Map<string, TemaLink[]>();

  for (const doc of docs) {
    if (doc.data.draft) {
      continue;
    }

    const temaName = doc.data.sidebar?.badge?.text;

    if (!temaName || !temaName.startsWith('Tema')) {
      continue;
    }

    if (!temaMap.has(temaName)) {
      temaMap.set(temaName, []);
    }

    temaMap.get(temaName)?.push(createTemaLink(doc));
  }

  temaSections = Array.from(temaMap.entries())
    .sort((a, b) => getTemaOrder(a[0]) - getTemaOrder(b[0]))
    .map(([name, items]) => ({
      name,
      number: extractTemaNumber(name),
      items,
    }));
} catch (error) {
  loadError =
    error instanceof Error ? error.message : 'Kunne ikke bygge temaoversigten.';
}
---

<StarlightPage
  frontmatter={{
    title: 'Tema Oversigt',
    description: 'Oversigt over alt indhold organiseret efter tema',
  }}
>
  <h1>Tema Oversigt</h1>
  <p class="intro">
    Find indhold organiseret efter tema. Denne oversigt opdateres automatisk
    baseret på badge-tags.
  </p>

  {loadError && (
    <p class="status error">Kunne ikke hente temaoversigten: {loadError}</p>
  )}

  {!loadError && temaSections.length === 0 && (
    <p class="status">Ingen temaer fundet.</p>
  )}

  {!loadError && temaSections.length > 0 && (
    <div class="filter-bar">
      <label for="tema-filter">Filtrer efter tema:</label>
      <select id="tema-filter">
        <option value="all">Alle temaer</option>
        {temaSections.map((tema) => (
          <option value={tema.number}>{tema.name}</option>
        ))}
      </select>
    </div>
  )}

  {temaSections.map((tema) => (
    <section class="tema-section" data-tema-number={tema.number}>
      <h2>{tema.name}</h2>
      <div class="tema-items">
        {tema.items.map((item) => (
          <article class="tema-card">
            <h3>{item.title}</h3>
            {item.description && <p>{item.description}</p>}
            <a href={item.href}>Læs mere →</a>
          </article>
        ))}
      </div>
    </section>
  ))}

  <script>
    const temaFilter = document.querySelector('#tema-filter');
    const sections = Array.from(document.querySelectorAll('.tema-section'));
    const normalizeTema = (value) => {
      if (!value || value === 'all') return 'all';
      return value.match(/\d+/)?.[0] || value;
    };

    const applyFilter = (selectedTema) => {
      sections.forEach((section) => {
        const sectionTemaNumber = section.getAttribute('data-tema-number');

        if (selectedTema === 'all' || selectedTema === sectionTemaNumber) {
          section.removeAttribute('hidden');
        } else {
          section.setAttribute('hidden', '');
        }
      });
    };

    if (temaFilter instanceof HTMLSelectElement) {
      const params = new URLSearchParams(window.location.search);
      const hasTemaParam = params.has('tema');
      const temaFromUrl = normalizeTema(params.get('tema'));
      const savedTema = normalizeTema(localStorage.getItem('selectedTheme') || 'all');
      const initialTema = hasTemaParam ? temaFromUrl : savedTema;

      if (initialTema) {
        const options = Array.from(temaFilter.options);
        const hasOption = options.some((option) => option.value === initialTema);

        if (hasOption) {
          temaFilter.value = initialTema;
        }
      }

      applyFilter(temaFilter.value);

      if (temaFilter.value === 'all') {
        localStorage.removeItem('selectedTheme');
      } else {
        localStorage.setItem('selectedTheme', temaFilter.value);
      }

      temaFilter.addEventListener('change', (e) => {
        const selectedTema = e.currentTarget instanceof HTMLSelectElement
          ? normalizeTema(e.currentTarget.value)
          : 'all';

        applyFilter(selectedTema);

        if (selectedTema === 'all') {
          localStorage.removeItem('selectedTheme');
        } else {
          localStorage.setItem('selectedTheme', selectedTema);
        }

        const nextUrl = new URL(window.location.href);
        if (selectedTema === 'all') {
          nextUrl.searchParams.delete('tema');
        } else {
          nextUrl.searchParams.set('tema', selectedTema);
        }
        window.history.replaceState({}, '', nextUrl.toString());
      });
    }
  </script>
</StarlightPage>

<style>
  .intro {
    margin-bottom: 1.5rem;
  }

  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }

  .filter-bar label {
    font-weight: 700;
  }

  .filter-bar select {
    min-width: 12rem;
    padding: 0.65rem 0.85rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
    background: var(--sl-color-bg);
    color: var(--sl-color-text);
  }

  .tema-section {
    margin-bottom: 2rem;
  }

  .tema-items {
    display: grid;
    gap: 0.85rem;
  }

  .tema-card {
    padding: 1rem 1.1rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 1rem;
    background: color-mix(in srgb, var(--sl-color-gray-6) 18%, transparent);
  }

  .tema-card h3 {
    margin: 0 0 0.35rem;
    font-size: 1.05rem;
  }

  .tema-card p {
    margin: 0 0 0.65rem;
  }

  .status {
    margin: 0 0 1.5rem;
    padding: 1rem 1.25rem;
    border-radius: 1rem;
    background: color-mix(in srgb, var(--sl-color-gray-6) 22%, transparent);
    border: 1px solid var(--sl-color-gray-5);
    color: var(--sl-color-text);
  }

  .error {
    border-color: color-mix(in srgb, var(--sl-color-red) 35%, transparent);
    background: color-mix(in srgb, var(--sl-color-red) 12%, transparent);
  }
</style>
