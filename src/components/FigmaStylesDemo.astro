<figma-styles-demo>
  <figure class="styles-demo">
    <label>
      <strong>Farve/Accent</strong>
      <select aria-label="Skift farven i Farve/Accent">
        <option value="#2563eb">Blå · #2563EB</option>
        <option value="#7c3aed">Lilla · #7C3AED</option>
        <option value="#047857">Grøn · #047857</option>
      </select>
    </label>
    <div class="styles-demo-examples">
      <div>
        <span>Forside</span>
        <span class="styles-demo-surface">Se opskrifter</span>
      </div>
      <div>
        <span>Opskriftsside</span>
        <span class="styles-demo-surface">Gem opskriften</span>
      </div>
    </div>
    <figcaption>Illustration: Begge knapflader bruger Farve/Accent. Kun farven ændres; tekst og form bevares.</figcaption>
    <p class="styles-demo-status" role="status" aria-live="polite"></p>
  </figure>
</figma-styles-demo>

<script>
  class FigmaStylesDemo extends HTMLElement {
    connectedCallback() {
      const select = this.querySelector('select');
      const status = this.querySelector('[role="status"]');
      if (!select) return;

      select.value = this.style.getPropertyValue('--demo-accent') || select.value;

      select.onchange = () => {
        this.style.setProperty('--demo-accent', select.value);
        if (status) {
          status.textContent = `Begge knapflader bruger nu ${select.selectedOptions[0].textContent}.`;
        }
      };
    }
  }

  if (!customElements.get('figma-styles-demo')) {
    customElements.define('figma-styles-demo', FigmaStylesDemo);
  }
</script>

<style>
  figma-styles-demo {
    --demo-accent: #2563eb;
    display: block;
    margin-block: 1rem;
  }

  .styles-demo {
    margin: 0;
    padding: 1rem;
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 0.75rem;
    background: var(--sl-color-bg);
    color: var(--sl-color-text);
    font-size: 1rem;
    line-height: 1.5;
  }

  .styles-demo label {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
  }

  .styles-demo select {
    max-width: 100%;
    margin: 0;
    padding: 0.5rem;
    border: 1px solid var(--sl-color-gray-3);
    border-radius: 0.3rem;
    background: var(--sl-color-bg);
    color: var(--sl-color-text);
    font: inherit;
  }

  .styles-demo select:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 3px;
  }

  .styles-demo-examples {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
    gap: 1rem;
    margin-top: 1rem;
  }

  .styles-demo-examples > div {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 1rem;
    border: 1px dashed var(--sl-color-gray-4);
    border-radius: 0.4rem;
  }

  .styles-demo-surface {
    display: block;
    width: fit-content;
    margin: 0;
    padding: 0.65rem 1rem;
    border-radius: 0.4rem;
    background: var(--demo-accent);
    color: #fff;
    font-weight: 700;
  }

  .styles-demo figcaption {
    margin-top: 0.75rem;
    color: var(--sl-color-gray-2);
    font-size: 0.85rem;
  }

  .styles-demo-status {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
</style>
