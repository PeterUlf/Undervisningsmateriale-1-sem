---
// src/components/Slide.astro
import '../styles/popover-lesson.css';
interface Props {
  variant?: 'paper' | 'lesson';
  label?: string;
}
const { variant, label } = Astro.props;
---

<div class="slide">
  {variant === 'paper' ? (
    /* Den indre ramme følger med, når slideshowet kopierer slidens indhold. */
    <div class="slide-paper">
      {label && <p class="slide-label">{label}</p>}
      <div class="slide-body"><slot /></div>
    </div>
  ) : variant === 'lesson' ? (
    <div class="popover-slide lesson-slide not-content">
      {label && <div class="pl-topline">{label}</div>}
      <div class="lesson-body"><slot /></div>
      {Astro.slots.has('takeaway') && <div class="pl-bottom"><slot name="takeaway" /></div>}
    </div>
  ) : <slot />}
</div>
