---
import PresentationMode from './PresentationMode.astro';

const title = Astro.locals.starlightRoute.entry.data.title;
const badgeText = Astro.locals.starlightRoute.entry.data.sidebar?.badge?.text;
const themeLabel = String(badgeText || '').match(/^Tema\s+\d+$/i)?.[0];
const hasThemePrefix = /^Tema\s+\d+\b/i.test(title);
const displayTitle = themeLabel && !hasThemePrefix ? `${themeLabel}: ${title}` : title;
const path = Astro.url.pathname.replace(/^\/draft(?=\/|$)/, '').replace(/\/$/, '');
const isPausePage = path === '/pause-ur';
const isSiteGuide = /^\/dette-site(?:\/|$)/.test(path) || (Astro.url.pathname.startsWith('/draft') && (path === '' || path === '/tema-oversigt'));
---

<h1 id="_top" data-site-guide={isSiteGuide || undefined} class:list={{ 'sr-only': isPausePage }}>{displayTitle}</h1>

{!isSiteGuide && <PresentationMode />}

<style>
  :global(body:has([data-site-guide]) .sl-markdown-content h2::before),
  :global(body:has([data-site-guide]) starlight-toc nav > ul > li > a::before) {
    content: none;
  }

  @layer starlight.core {
    h1 {
      margin-top: 1rem;
      font-size: var(--sl-text-h1);
      line-height: var(--sl-line-height-headings);
      font-weight: 600;
      color: var(--sl-color-white);
    }
  }
</style>
