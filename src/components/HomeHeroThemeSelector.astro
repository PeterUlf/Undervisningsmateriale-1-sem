<div class="hero-theme-selector" aria-label="Temavælger på forsiden">
  <label for="home-theme-select">Vælg tema</label>
  <select
    id="home-theme-select"
    onchange="if (this.value) window.location.assign(this.value)"
  >
    <option value="">Vælg tema...</option>
    <option value="/tema-oversigt/?tema=all">Alle temaer</option>
    <option value="/tema-oversigt/?tema=1">Tema 1</option>
    <option value="/tema-oversigt/?tema=2">Tema 2</option>
    <option value="/tema-oversigt/?tema=3">Tema 3</option>
    <option value="/tema-oversigt/?tema=4">Tema 4</option>
    <option value="/tema-oversigt/?tema=5">Tema 5</option>
    <option value="/tema-oversigt/?tema=7">Tema 7</option>
    <option value="/tema-oversigt/?tema=8">Tema 8</option>
    <option value="/tema-oversigt/?tema=9">Tema 9</option>
  </select>
</div>

<script>
  // @ts-nocheck
  function placeThemeSelectorInHeroActions() {
    const heroActions = document.querySelector(".hero .actions");
    const themeSelector = document.querySelector(".hero-theme-selector");

    if (!heroActions || !themeSelector) return;
    if (heroActions.contains(themeSelector)) return;

    heroActions.appendChild(themeSelector);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", placeThemeSelectorInHeroActions);
  } else {
    placeThemeSelectorInHeroActions();
  }

  document.addEventListener("astro:page-load", placeThemeSelectorInHeroActions);
</script>
