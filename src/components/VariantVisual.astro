---
interface Props {
  step: number;
  total: number;
  kind?: string;
  illustration?: string;
}
const { step, total, kind = '', illustration } = Astro.props;
---

<section class:list={['variant-visual', 'not-content', kind && `vv-${kind}`]} aria-label={`Slide ${step} af ${total} om varianter`}>
  <div class="vv-topline"><span>Figma / Varianter</span><span>{String(step).padStart(2, '0')} <span class="vv-muted">/ {total}</span></span></div>
  <slot />
  {Astro.slots.has('takeaway') && <div class="vv-bottom"><span class="vv-dot" aria-hidden="true"></span><div><slot name="takeaway" /></div></div>}
  {illustration && <p class="vv-credit">
    {illustration} · Original illustration med AI-assistance: Codex, 12.10.2026.
    Ingen særskilt åben licens. <a href="/dette-site/figma-varianter-visuelt-undervisernoter/#billedkilder">Billedkilder og vilkår</a>.
  </p>}
</section>
