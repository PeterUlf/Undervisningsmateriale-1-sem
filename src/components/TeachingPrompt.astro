---
import { Content } from '../../prompts/undervisningsslides.md';
import source from '../../prompts/undervisningsslides.md?raw';
const prompt = source.split('## PROMPT START')[1].split('## PROMPT SLUT')[0].trim();
---

<div class="prompt-tools">
  <button type="button" id="copy-teaching-prompt">Kopiér prompten</button>
  <span id="prompt-copy-status" role="status" aria-live="polite"></span>
  <details id="prompt-source-details">
    <summary>Vis prompten som tekst</summary>
    <textarea id="teaching-prompt-source" readonly aria-label="Prompt til kopiering" rows="14">{prompt}</textarea>
  </details>
</div>
<Content />

<script>
  document.querySelector('#copy-teaching-prompt')?.addEventListener('click', async () => {
    const source = document.querySelector<HTMLTextAreaElement>('#teaching-prompt-source');
    const status = document.querySelector('#prompt-copy-status');
    if (!source || !status) return;
    try {
      await navigator.clipboard.writeText(source.value);
      status.textContent = 'Prompten er kopieret.';
    } catch {
      const details = document.querySelector<HTMLDetailsElement>('#prompt-source-details');
      if (details) details.open = true;
      source.focus();
      source.select();
      status.textContent = 'Teksten er markeret. Kopiér med Cmd+C eller Ctrl+C.';
    }
  });
</script>

<style>
  .prompt-tools { margin-block: 1rem 2rem; }
  button { padding: .6rem 1rem; background: var(--sl-color-accent); color: var(--sl-color-black); border: 0; border-radius: .4rem; font: inherit; cursor: pointer; }
  #prompt-copy-status { margin-left: .75rem; }
  details { margin-top: 1rem; }
  textarea { width: 100%; padding: .75rem; margin-top: .5rem; font-size: .9rem; color: var(--sl-color-white); background: var(--sl-color-bg); border: 1px solid var(--sl-color-gray-4); }
</style>
