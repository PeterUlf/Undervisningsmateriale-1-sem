---
import { getCollection } from 'astro:content';
import type { Props } from '@astrojs/starlight/props';
import Default from '@astrojs/starlight/components/Sidebar.astro';

const docs = await getCollection('docs');

const extractTemaNumber = (value?: string) => value?.match(/\d+/)?.[0] || '';
const normalizeDocPath = (value: string) => {
  const withoutExtension = value.replace(/\.mdx?$/, '');
  const withoutIndex = withoutExtension.replace(/\/index$/, '');
  return withoutIndex === '' ? '/' : `${withoutIndex}/`;
};

const linkThemeMap = Object.fromEntries(
  docs.flatMap((doc) => {
    const temaNumber = extractTemaNumber(doc.data.sidebar?.badge?.text);

    if (!temaNumber) {
      return [];
    }

    return [[`/${normalizeDocPath(doc.id)}`, temaNumber]];
  })
);

const availableThemes = Array.from(new Set(Object.values(linkThemeMap)))
  .sort((a, b) => Number(a) - Number(b));
---

<div id="theme-filter-container">
  <label for="theme-select">Vis temaer:</label>
  <select id="theme-select">
    <option value="all">Alle temaer</option>
  </select>
</div>

<Default {...Astro.props}><slot /></Default>

<script define:vars={{ availableThemes, linkThemeMap }}>
  const themeNames = {
    1: 'Introuge',
    2: 'Web I',
    3: 'UX I',
    4: 'Brugergrænseflade udvikling I',
    5: 'Indhold I',
    6: 'Eksamen',
    7: 'Indhold II',
    8: 'Web II',
    9: 'UX/UI II',
    10: 'Eksamensprojekt',
  };

  const normalizeTheme = (value) => {
    if (!value || value === 'all') return 'all';
    return value.match(/\d+/)?.[0] || value;
  };

  const normalizeLinkHref = (href) => {
    if (!href) return '';

    if (
      href.startsWith('http://') ||
      href.startsWith('https://') ||
      href.startsWith('mailto:') ||
      href.startsWith('#')
    ) {
      return href;
    }

    const [path] = href.split(/[?#]/);
    if (!path.startsWith('/')) {
      return '';
    }

    const normalizedPath = path.replace(/\/index\/?$/, '/').replace(/\/+$/, '');
    return normalizedPath === '' ? '/' : `${normalizedPath}/`;
  };

  const getThemeForLink = (link) => {
    const href = normalizeLinkHref(link.getAttribute('href'));
    const mappedTheme = href ? linkThemeMap[href] : undefined;

    if (mappedTheme) {
      return mappedTheme;
    }

    const badge = link.querySelector('.sl-badge');
    const badgeText = badge?.textContent?.trim();
    const badgeTheme = badgeText?.match(/\d+/)?.[0];

    return badgeTheme || '';
  };

  function buildThemeOptions(select) {
    if (select.dataset.optionsReady === 'true') return;

    availableThemes.forEach((num) => {
      const option = document.createElement('option');
      option.value = num;
      const themeName = themeNames[num] || '';
      option.textContent = themeName ? `Tema ${num} - ${themeName}` : `Tema ${num}`;
      select.appendChild(option);
    });

    select.dataset.optionsReady = 'true';
  }

  function rememberInitialGroupState(sidebarRoot) {
    const groups = sidebarRoot.querySelectorAll('details');

    groups.forEach((group) => {
      if (group.dataset.initialOpen) return;
      group.dataset.initialOpen = group.open ? 'true' : 'false';
    });
  }

  function restoreInitialGroupState(sidebarRoot) {
    const groups = sidebarRoot.querySelectorAll('details');

    groups.forEach((group) => {
      group.open = group.dataset.initialOpen === 'true';
    });
  }

  function openGroupsForCurrentPage(sidebarRoot) {
    const currentPath = normalizeLinkHref(window.location.pathname);
    const sidebarLinks = Array.from(sidebarRoot.querySelectorAll('a'));
    const currentLink = sidebarLinks.find((link) => {
      const href = normalizeLinkHref(link.getAttribute('href'));
      const ariaCurrent = link.getAttribute('aria-current');

      return href === currentPath || ariaCurrent === 'page' || ariaCurrent === 'true';
    });

    if (!currentLink) return;

    const currentListItem = currentLink.closest('li');
    if (currentListItem && currentListItem.style.display === 'none') {
      return;
    }

    let parent = currentLink.parentElement;

    while (parent) {
      if (parent.tagName === 'DETAILS') {
        parent.open = true;
        parent.style.display = '';

        const listItem = parent.closest('li');
        if (listItem) {
          listItem.style.display = '';
        }
      }

      parent = parent.parentElement;
    }
  }

  function getSelectedTheme() {
    const urlParams = new URLSearchParams(window.location.search);
    const rawUrlTheme = urlParams.get('tema');
    const urlTheme = normalizeTheme(rawUrlTheme);
    const storedTheme = normalizeTheme(localStorage.getItem('selectedTheme') || 'all');

    if (rawUrlTheme) {
      return availableThemes.includes(urlTheme) ? urlTheme : 'all';
    }

    if (storedTheme === 'all') return 'all';
    return availableThemes.includes(storedTheme) ? storedTheme : 'all';
  }

  function filterMenuItems(sidebarRoot, selectedTheme) {
    const normalizedTheme = normalizeTheme(selectedTheme);
    const isAll = normalizedTheme === 'all';
    const sidebarLinks = sidebarRoot.querySelectorAll('a');

    sidebarLinks.forEach((link) => {
      const listItem = link.closest('li');
      if (!listItem) return;

      const themeNumber = getThemeForLink(link);

      if (isAll) {
        listItem.style.display = '';
        return;
      }

      listItem.style.display = themeNumber === normalizedTheme ? '' : 'none';
    });

    const sidebarGroups = Array.from(sidebarRoot.querySelectorAll('details')).reverse();

    sidebarGroups.forEach((group) => {
      const childList = group.querySelector(':scope > ul');

      if (!childList) return;

      const childItems = Array.from(childList.children).filter(
        (child) => child.tagName === 'LI'
      );

      const hasVisibleChildren = childItems.some((item) => {
        const directLink = Array.from(item.children).find(
          (child) => child.tagName === 'A'
        );
        const nestedGroup = Array.from(item.children).find(
          (child) => child.tagName === 'DETAILS'
        );

        if (directLink) {
          return item.style.display !== 'none';
        }

        if (nestedGroup) {
          return nestedGroup.style.display !== 'none';
        }

        return item.style.display !== 'none';
      });

      group.style.display = hasVisibleChildren ? '' : 'none';

      const detailsListItem = group.closest('li');
      if (detailsListItem) {
        detailsListItem.style.display = hasVisibleChildren ? '' : 'none';
      }

      if (!isAll) {
        group.open = hasVisibleChildren;
      }
    });

    if (isAll) {
      restoreInitialGroupState(sidebarRoot);
    }

    openGroupsForCurrentPage(sidebarRoot);
  }

  function updateThemeUrl(selectedTheme) {
    const url = new URL(window.location.href);

    if (selectedTheme === 'all') {
      url.searchParams.delete('tema');
    } else {
      url.searchParams.set('tema', selectedTheme);
    }

    window.history.replaceState({}, '', url.toString());
  }

  function syncSidebarThemeFilter() {
    const sidebarRoot = document.getElementById('starlight__sidebar');
    const select = document.getElementById('theme-select');

    if (!sidebarRoot || !(select instanceof HTMLSelectElement) || availableThemes.length === 0) {
      return;
    }

    buildThemeOptions(select);
    rememberInitialGroupState(sidebarRoot);

    const selectedTheme = getSelectedTheme();
    select.value = selectedTheme;

    if (selectedTheme === 'all') {
      localStorage.removeItem('selectedTheme');
    } else {
      localStorage.setItem('selectedTheme', selectedTheme);
    }

    window.requestAnimationFrame(() => {
      filterMenuItems(sidebarRoot, selectedTheme);
    });

    if (select.dataset.listenerAttached === 'true') return;

    select.addEventListener('change', (e) => {
      const target = e.currentTarget;
      if (!(target instanceof HTMLSelectElement)) return;

      const nextTheme = normalizeTheme(target.value);

      if (nextTheme === 'all') {
        localStorage.removeItem('selectedTheme');
      } else {
        localStorage.setItem('selectedTheme', nextTheme);
      }

      updateThemeUrl(nextTheme);
      filterMenuItems(sidebarRoot, nextTheme);
    });

    select.dataset.listenerAttached = 'true';
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', syncSidebarThemeFilter);
  } else {
    syncSidebarThemeFilter();
  }

  document.addEventListener('astro:page-load', syncSidebarThemeFilter);
</script>

<style>
  #theme-filter-container {
    padding: 1rem;
    border-bottom: 1px solid var(--sl-color-gray-5);
    margin-bottom: 1rem;
  }

  #theme-filter-container label {
    display: block;
    font-weight: 600;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-white);
    margin-bottom: 0.5rem;
  }

  #theme-select {
    width: 100%;
    padding: 0.5rem;
    background: var(--sl-color-gray-6);
    color: var(--sl-color-white);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.375rem;
    font-size: var(--sl-text-sm);
    cursor: pointer;
  }

  #theme-select:hover {
    background: var(--sl-color-gray-5);
  }

  #theme-select:focus {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }
</style>
