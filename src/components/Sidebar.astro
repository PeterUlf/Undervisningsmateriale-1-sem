---
import { getCollection } from 'astro:content';
import type { Props } from '@astrojs/starlight/props';
import Default from '@astrojs/starlight/components/Sidebar.astro';

const docs = await getCollection('docs');

const extractTemaNumber = (value?: string) => value?.match(/\d+/)?.[0] || '';
const normalizeDocPath = (value: string) => {
  const withoutExtension = value.replace(/\.mdx?$/, '');
  const withoutIndex = withoutExtension.replace(/\/index$/, '');
  return withoutIndex === '' ? '/' : `${withoutIndex}/`;
};

const linkThemeMap = Object.fromEntries(
  docs.flatMap((doc) => {
    const temaNumber = extractTemaNumber(doc.data.sidebar?.badge?.text);

    if (!temaNumber) {
      return [];
    }

    return [[`/${normalizeDocPath(doc.id)}`, temaNumber]];
  })
);

const availableThemes = Array.from(new Set(Object.values(linkThemeMap)))
  .sort((a, b) => Number(a) - Number(b));
---

<div id="theme-filter-container">
  <label for="theme-select">Vis temaer:</label>
  <select id="theme-select">
    <option value="all">Alle temaer</option>
  </select>
</div>

<Default {...Astro.props}><slot /></Default>

<script define:vars={{ availableThemes, linkThemeMap }}>
  // Rod-elementet for Starlight-sidebaren
  const sidebarRoot = document.getElementById('starlight__sidebar');

  if (sidebarRoot) {
    // Byg options dynamisk
    const select = document.getElementById('theme-select');
    
    if (select && availableThemes.length > 0) {
      // Tema navne
      const themeNames = {
        1: 'Introuge',
        2: 'Web I',
        3: 'UX I',
        4: 'Brugergrænseflade udvikling I',
        5: 'Indhold I',
        6: 'Eksamen',
        7: 'Indhold II',
        8: 'Web II',
        9: 'UX/UI II',
      };
      
      // Tilføj tema options (ét tema ad gangen)
      availableThemes.forEach((num) => {
        const option = document.createElement('option');
        option.value = num;
        const themeName = themeNames[num] || '';
        option.textContent = themeName ? `Tema ${num} - ${themeName}` : `Tema ${num}`;
        select.appendChild(option);
      });
      
      // Hent gemt valg eller check for URL parameter
      const urlParams = new URLSearchParams(window.location.search);
      const urlTheme = urlParams.get('tema');
      const savedTheme = urlTheme || localStorage.getItem('selectedTheme') || 'all';
      select.value = savedTheme;
      
      // Gem tema fra URL til localStorage
      if (urlTheme) {
        localStorage.setItem('selectedTheme', urlTheme);
      }
      
      // Funktion til at filtrere
      function filterMenuItems(selectedTheme) {
        const isAll = selectedTheme === 'all';

        const normalizeLinkHref = (href) => {
          if (!href) return '';

          if (
            href.startsWith('http://') ||
            href.startsWith('https://') ||
            href.startsWith('mailto:') ||
            href.startsWith('#')
          ) {
            return href;
          }

          const [path] = href.split(/[?#]/);
          if (!path.startsWith('/')) {
            return '';
          }

          const normalizedPath = path.replace(/\/index\/?$/, '/').replace(/\/+$/, '');
          return normalizedPath === '' ? '/' : `${normalizedPath}/`;
        };

        const getThemeForLink = (link) => {
          const href = normalizeLinkHref(link.getAttribute('href'));
          const mappedTheme = href ? linkThemeMap[href] : undefined;

          if (mappedTheme) {
            return mappedTheme;
          }

          const badge = link.querySelector('.sl-badge');
          const badgeText = badge?.textContent?.trim();
          const badgeTheme = badgeText?.match(/\d+/)?.[0];

          return badgeTheme || '';
        };

        // Filtrér alle links i den rigtige sidebar
        const sidebarLinks = sidebarRoot.querySelectorAll('a');

        sidebarLinks.forEach((link) => {
          const listItem = link.closest('li');
          if (!listItem) return;

          const liEl = listItem;
          const themeNumber = getThemeForLink(link);

          if (isAll) {
            liEl.style.display = '';
            return;
          }

          liEl.style.display = themeNumber === selectedTheme ? '' : 'none';
        });
        
        // Skjul tomme grupper nedefra, så forældre ikke tæller skjulte undergrupper med.
        const sidebarGroups = Array.from(sidebarRoot.querySelectorAll('details')).reverse();

        sidebarGroups.forEach((group) => {
          const detailsEl = group;
          const childList = detailsEl.querySelector(':scope > ul');

          if (!childList) return;

          const childItems = Array.from(childList.children).filter(
            (child) => child.tagName === 'LI'
          );

          const hasVisibleChildren = childItems.some((item) => {
            const directLink = Array.from(item.children).find(
              (child) => child.tagName === 'A'
            );
            const nestedGroup = Array.from(item.children).find(
              (child) => child.tagName === 'DETAILS'
            );

            if (directLink) {
              return item.style.display !== 'none';
            }

            if (nestedGroup) {
              return nestedGroup.style.display !== 'none';
            }

            return item.style.display !== 'none';
          });

          detailsEl.style.display = hasVisibleChildren ? '' : 'none';

          const detailsListItem = detailsEl.closest('li');
          if (detailsListItem) {
            detailsListItem.style.display = hasVisibleChildren ? '' : 'none';
          }
        });
      }

      function updateThemeUrl(selectedTheme) {
        const url = new URL(window.location.href);
        if (selectedTheme === 'all') {
          url.searchParams.delete('tema');
        } else {
          url.searchParams.set('tema', selectedTheme);
        }
        window.history.replaceState({}, '', url.toString());
      }
      
      // Filtrer ved load
      filterMenuItems(savedTheme);
      
      // Lyt efter ændringer
      select.addEventListener('change', (e) => {
        const target = e.currentTarget;
        if (!(target instanceof HTMLSelectElement)) return;

        const selectedTheme = target.value;
        localStorage.setItem('selectedTheme', selectedTheme);
        updateThemeUrl(selectedTheme);
        filterMenuItems(selectedTheme);
      });
    }
  }
</script>

<style>
  #theme-filter-container {
    padding: 1rem;
    border-bottom: 1px solid var(--sl-color-gray-5);
    margin-bottom: 1rem;
  }

  #theme-filter-container label {
    display: block;
    font-weight: 600;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-white);
    margin-bottom: 0.5rem;
  }

  #theme-select {
    width: 100%;
    padding: 0.5rem;
    background: var(--sl-color-gray-6);
    color: var(--sl-color-white);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.375rem;
    font-size: var(--sl-text-sm);
    cursor: pointer;
  }

  #theme-select:hover {
    background: var(--sl-color-gray-5);
  }

  #theme-select:focus {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }
</style>
