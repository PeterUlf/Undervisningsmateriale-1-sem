<pause-timer class="not-content">
  <div class="timer-display">
    <p class="resume-heading">Vi starter igen <span data-resume-time>--:--</span></p>
    <p class="countdown" role="timer" aria-live="off">
      Der er <span data-countdown>--:--:--</span> tilbage til vi starter
    </p>
    <p class="timer-status" role="status" data-status>Indtast et klokkeslæt for at starte nedtællingen.</p>
  </div>

  <div class="timer-settings">
    <label class="time-field">
      <span>Starttidspunkt</span>
      <input
        type="text"
        placeholder="00:00"
        maxlength="5"
        pattern="([01][0-9]|2[0-3]):[0-5][0-9]"
        autocomplete="off"
        spellcheck="false"
        aria-label="Starttidspunkt i formatet 00:00"
      />
    </label>
    <p class="time-hint">Skriv fx 10:30. Et tidligere klokkeslæt gælder i morgen.</p>
  </div>
</pause-timer>

<script>
  class PauseTimer extends HTMLElement {
    // Del tidspunktet med kopien i slideshowet, så begge visninger følges ad.
    static instances = new Set<PauseTimer>();
    static value = '';
    static resumeAt: number | null = null;

    interval: number | undefined;

    connectedCallback() {
      PauseTimer.instances.add(this);
      this.querySelector('input')?.addEventListener('input', this.updateTime);
      this.render();
      this.interval = window.setInterval(() => this.render(), 1000);
    }

    disconnectedCallback() {
      PauseTimer.instances.delete(this);
      this.querySelector('input')?.removeEventListener('input', this.updateTime);
      window.clearInterval(this.interval);
    }

    updateTime = () => {
      const input = this.querySelector('input');
      if (!input) return;

      PauseTimer.value = input.value;
      PauseTimer.resumeAt = null;

      if (/^([01]\d|2[0-3]):[0-5]\d$/.test(input.value)) {
        const [hours, minutes] = input.value.split(':').map(Number);
        const now = new Date();
        const resume = new Date(now);
        resume.setHours(hours, minutes, 0, 0);

        // Samme minut er allerede nået; tidligere klokkeslæt er næste dag.
        if (hours * 60 + minutes < now.getHours() * 60 + now.getMinutes()) {
          resume.setDate(resume.getDate() + 1);
        }

        PauseTimer.resumeAt = resume.getTime();
      }

      PauseTimer.instances.forEach((timer) => timer.render());
    };

    render() {
      const input = this.querySelector('input');
      const resumeTime = this.querySelector('[data-resume-time]');
      const countdown = this.querySelector('[data-countdown]');
      const status = this.querySelector('[data-status]');
      if (!input || !resumeTime || !countdown || !status) return;

      if (input.value !== PauseTimer.value) input.value = PauseTimer.value;

      const invalid = PauseTimer.value.length === 5 && PauseTimer.resumeAt === null;
      input.setAttribute('aria-invalid', String(invalid));
      let message = 'Indtast et klokkeslæt for at starte nedtællingen.';

      if (PauseTimer.resumeAt === null) {
        resumeTime.textContent = '--:--';
        countdown.textContent = '--:--:--';
        if (invalid) message = 'Brug formatet 00:00 med et klokkeslæt fra 00:00 til 23:59.';
      } else {
        const secondsLeft = Math.max(0, Math.ceil((PauseTimer.resumeAt - Date.now()) / 1000));
        const hours = Math.floor(secondsLeft / 3600);
        const minutes = Math.floor((secondsLeft % 3600) / 60);
        const seconds = secondsLeft % 60;
        const parts = [hours, minutes, seconds];

        resumeTime.textContent = PauseTimer.value;
        countdown.textContent = parts.map((part) => String(part).padStart(2, '0')).join(':');
        const tomorrow = new Date(PauseTimer.resumeAt).toDateString() !== new Date().toDateString();
        message = secondsLeft === 0 ? 'Vi starter nu.' : tomorrow ? 'Vi starter igen i morgen.' : '';
      }

      // Skærmlæsere får statusændringer, uden at hvert sekund bliver læst op.
      if (status.textContent !== message) status.textContent = message;
    }
  }

  if (!customElements.get('pause-timer')) {
    customElements.define('pause-timer', PauseTimer);
  }
</script>

<style>
  pause-timer {
    display: block;
    container-type: inline-size;
    padding: clamp(1rem, 4vw, 3rem) 0;
    color: var(--sl-color-white);
    text-align: center;
  }

  .timer-settings {
    margin-top: 3rem;
  }

  :global(.generated-slide) .timer-settings {
    display: none;
  }

  .time-field {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.75rem;
    font-size: 1rem;
    font-weight: 600;
  }

  input {
    width: 7ch;
    padding: 0.5rem;
    border: 1px solid var(--sl-color-gray-3);
    border-radius: 0.5rem;
    background: var(--sl-color-bg);
    color: var(--sl-color-white);
    font: inherit;
    font-size: 1.5rem;
    font-variant-numeric: tabular-nums;
    text-align: center;
  }

  input:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 3px;
  }

  input[aria-invalid="true"] {
    border-color: var(--sl-color-red-high);
  }

  .time-hint,
  .timer-status {
    margin: 0.75rem 0 0;
    color: var(--sl-color-gray-2);
    font-size: 1rem;
  }

  .timer-status:empty {
    display: none;
  }

  .resume-heading {
    margin: 0;
    font-size: clamp(1.5rem, 8.5cqi, 4rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.025em;
  }

  .countdown {
    margin: 1rem 0 0;
    font-size: clamp(0.95rem, 3.8cqi, 1.75rem);
    font-weight: 500;
    line-height: 1.5;
  }

  [data-resume-time],
  [data-countdown] {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
</style>
