<figma-interaction-demo>
  <figure class="interaction-demo">
    <div class="interaction-screen" data-screen="home">
      <p class="interaction-frame">Frame: Forside</p>
      <h3 tabindex="-1">Find din næste opskrift</h3>
      <p>Prøv en nem pasta med tomat og basilikum.</p>
      <button type="button" data-destination="recipe">Se opskriften →</button>
    </div>
    <div class="interaction-screen" data-screen="recipe" hidden>
      <p class="interaction-frame">Frame: Opskrift</p>
      <h3 tabindex="-1">Pasta med tomat</h3>
      <p>20 minutter · 2 personer</p>
      <p>Kog pasta, vend den i tomatsauce, og top med basilikum.</p>
      <button type="button" data-destination="home">← Tilbage til forsiden</button>
    </div>
    <p class="interaction-event" role="status">Klik på knappen for at gå fra Forside til Opskrift.</p>
    <figcaption>Klikbar illustration af to frames. I Figma opretter du forbindelserne fra Prototype-fanen.</figcaption>
  </figure>
</figma-interaction-demo>

<script>
  class FigmaInteractionDemo extends HTMLElement {
    connectedCallback() {
      this.querySelectorAll<HTMLButtonElement>('button[data-destination]').forEach((button) => {
        button.onclick = () => {
          const destination = button.dataset.destination;
          const screens = this.querySelectorAll<HTMLElement>('[data-screen]');
          const nextScreen = [...screens].find((screen) => screen.dataset.screen === destination);
          if (!nextScreen) return;

          screens.forEach((screen) => { screen.hidden = screen !== nextScreen; });
          const status = this.querySelector('[role="status"]');
          if (status) {
            status.textContent = `On click → Navigate to → ${destination === 'recipe' ? 'Opskrift' : 'Forside'}`;
          }
          nextScreen.querySelector<HTMLElement>('h3')?.focus({ preventScroll: true });
        };
      });
    }
  }

  if (!customElements.get('figma-interaction-demo')) {
    customElements.define('figma-interaction-demo', FigmaInteractionDemo);
  }
</script>

<style>
  figma-interaction-demo {
    display: block;
    margin-block: 1rem;
  }

  .interaction-demo {
    margin: 0;
    padding: 1rem;
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 0.75rem;
    background: var(--sl-color-bg);
    color: var(--sl-color-text);
    font-size: 1rem;
    line-height: 1.5;
  }

  .interaction-screen {
    display: grid;
    align-content: start;
    gap: 0.8rem;
    min-height: 17rem;
    margin: 0;
    padding: 1.25rem;
    border: 1px solid #cbd5e1;
    border-radius: 0.5rem;
    background: #f8fafc;
    color: #0f172a;
  }

  .interaction-screen[hidden] {
    display: none;
  }

  .interaction-screen p,
  .interaction-screen h3 {
    margin: 0;
    color: inherit;
  }

  .interaction-screen h3 {
    font-size: 1.35rem;
    line-height: 1.3;
  }

  .interaction-screen .interaction-frame {
    color: #475569;
    font-size: 0.85rem;
  }

  .interaction-screen button {
    width: fit-content;
    max-width: 100%;
    margin: 0;
    padding: 0.7rem 1rem;
    border: 0;
    border-radius: 0.4rem;
    background: #2563eb;
    color: #fff;
    font: inherit;
    font-weight: 700;
    text-align: start;
    cursor: pointer;
  }

  .interaction-screen button:hover {
    background: #1d4ed8;
  }

  .interaction-screen :focus-visible {
    outline: 2px solid #1d4ed8;
    outline-offset: 4px;
  }

  .interaction-event {
    margin-top: 0.75rem;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .interaction-demo figcaption {
    margin-top: 0.5rem;
    color: var(--sl-color-gray-2);
    font-size: 0.85rem;
  }
</style>
